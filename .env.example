# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection String
# Leave blank in preview to run in Demo Fallback Mode without database credentials
MONGODB_URI=

# JWT Secret for Demo Authentication (server generates an ephemeral fallback if omitted)
JWT_SECRET=

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:3000

# Optional Cloudinary Image Storage (sample local/fallback images work without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GEMINI_API_KEY: Optional AI Studio environment variable
GEMINI_API_KEY=
APP_URL=
